    rdfs:label "XY section viewer configuration" ;
    dct:abstract "Per-block configuration for the bblocks-viewer XY Section view of topo-feature documents: which features are drawn and how (rules shared with the Three.js and globe views), plus floor levels, section heights, the boundary parcel and excluded solids."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-30T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
