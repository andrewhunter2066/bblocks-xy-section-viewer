<bblocks://ogc.bbr.xysection.xySectionViewerDemo.builtStrata> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "XY Section demo: built strata" ;
    dct:abstract "A Western Australian built-strata survey (strata plan SP83687) as a topo-feature document — two floors of units and courtyards with walls, slabs and ceiling as occupation features — shown as one plan section per floor with WA level names and the former-tenure lot as the boundary."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-30T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-xy-section-viewer/bblock/ogc.bbr.xysection.xySectionViewerDemo.builtStrata> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-xy-section-viewer/build/generateddocs/markdown/bbr/xysection/xySectionViewerDemo/builtStrata/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://andrewhunter2066.github.io/bblocks-xy-section-viewer/build/generateddocs/json-full/bbr/xysection/xySectionViewerDemo/builtStrata/index.json> ] ;
    dct:hasVersion "0.1" ;
