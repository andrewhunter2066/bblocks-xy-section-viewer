    rdfs:seeAlso <bblocks://ogc.bbr.xysection.xySectionViewerConfig> ;
    skos:inScheme <https://andrewhunter2066.github.io/bblocks-xy-section-viewer/> ;
    skos:prefLabel "XY Section demo: built strata" ;
